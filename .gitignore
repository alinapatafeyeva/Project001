# Unity 6 .gitignore
# Keeps all source (Assets, Packages, ProjectSettings) and ignores everything Unity regenerates.

# ---- Editor-generated caches & build artifacts ----
# Rebuilt automatically by the Editor on open; never needs to be versioned.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/

# ---- Editor auto-generated files ----
# Machine/session-specific state, recreated on next Editor launch.
sysinfo.txt
*.tmp
*.apk
*.aab
*.unitypackage

# ---- IDE / solution files ----
# Regenerated by Unity/Rider/VS whenever the project is opened; not part of the source of truth.
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- Asset meta backups / crash files ----
*.pidb.meta
*.pdb.meta
*.mdb.meta
crashlytics-build.properties

# ---- OS-generated files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---- Addressables / packages cache ----
# Local package resolution cache; Packages/manifest.json (the real source) is kept.
/[Pp]ackages/packages-lock.json.meta

# ---- Recordings & captures (optional local artifacts) ----
/[Rr]ecordings/

# ---- Explicitly kept (documented for clarity — not actually ignored) ----
# Assets/            -> project source, always tracked
# ProjectSettings/   -> shared project configuration, always tracked
# Packages/manifest.json -> package dependency list, always tracked

# ---- Root-level local reference material (not part of project source) ----
/reference/
